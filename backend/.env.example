# Leave empty to run in offline mock mode (uses seed/fixtures/*.json instead of calling Sarvam)
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
DOC_LANGUAGE=en-IN
SARVAM_TOKEN_BUDGET=150000
SARVAM_PAGE_BUDGET=40
EXTRACT_MAX_TOKENS=2500
EXPLAIN_MAX_TOKENS=400
# set to "mock" to force offline fixtures (used by tests)
SARVAM_MODE=live
